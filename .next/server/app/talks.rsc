clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true,"className":"youtube-embed"}]}],["$","div",null,{"className":"talk-content","children":[["$","h2",null,{"className":"talk-title","children":"A Normie Approach to Validating LLM Outputs (AI.Science Talk)"}],["$","div",null,{"className":"talk-meta","children":[["$","span",null,{"className":"talk-event","children":"AI.Science"}],["$","time",null,{"className":"talk-date","children":"December 15, 2023"}]]}],["$","p",null,{"className":"talk-description","children":"A practical walkthrough of how to handle messy, stochastic LLM responses—especially from local or quantized models—using cheap and reliable techniques like Pydantic validation and while loops. Includes a demo chatbot built on quantized LLaMA 2 and how to enforce predictable JSON responses from unpredictable models."}],["$","div",null,{"className":"talk-topics","children":[["$","span","AI",{"className":"topic-tag","children":"AI"}],["$","span","LLM",{"className":"topic-tag","children":"LLM"}],["$","span","Validation",{"className":"topic-tag","children":"Validation"}],["$","span","Pydantic",{"className":"topic-tag","children":"Pydantic"}],["$","span","Agents",{"className":"topic-tag","children":"Agents"}],["$","span","Open Source",{"className":"topic-tag","children":"Open Source"}],["$","span","Prompt Engineering",{"className":"topic-tag","children":"Prompt Engineering"}]]}]]}]]}],["$","article","talk-building-https-model-api-for-cheap",{"className":"talk-card","children":[["$","div",null,{"className":"talk-video","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/DRGxjfLVrTA","title":"Building an HTTPS Model API for Cheap: AWS, Docker, and the Normconf API","frameBorder":"0","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true,"className":"youtube-embed"}]}],["$","div",null,{"className":"talk-content","children":[["$","h2",null,{"className":