{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/workshop",
      "destination": "/code-ai",
      "statusCode": 308,
      "regex": "^(?!/_next)/workshop(?:/)?$"
    },
    {
      "source": "/workshop/:slug",
      "destination": "/code-ai/:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/workshop(?:/([^/]+?))(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/api/og",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, immutable, no-transform, s-maxage=31536000, max-age=31536000"
        }
      ],
      "regex": "^/api/og(?:/)?$"
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/assets(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/audio/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/audio(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/posts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/posts(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/_next/static(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/archives/[month]",
      "regex": "^/archives/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmonth": "nxtPmonth"
      },
      "namedRegex": "^/archives/(?<nxtPmonth>[^/]+?)(?:/)?$"
    },
    {
      "page": "/code-ai/[id]",
      "regex": "^/code\\-ai/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/code\\-ai/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/posts/[slug]",
      "regex": "^/posts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/posts/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tags/[tag]",
      "regex": "^/tags/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtag": "nxtPtag"
      },
      "namedRegex": "^/tags/(?<nxtPtag>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/archive",
      "regex": "^/archive(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/archive(?:/)?$"
    },
    {
      "page": "/code-ai",
      "regex": "^/code\\-ai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/code\\-ai(?:/)?$"
    },
    {
      "page": "/posts",
      "regex": "^/posts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/posts(?:/)?$"
    },
    {
      "page": "/publications",
      "regex": "^/publications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/publications(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/rss.xml",
      "regex": "^/rss\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rss\\.xml(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/tags",
      "regex": "^/tags(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tags(?:/)?$"
    },
    {
      "page": "/talks",
      "regex": "^/talks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/talks(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}