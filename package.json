{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.839.0",
    "@aws-sdk/credential-provider-ini": "^3.839.0",
    "@craco/craco": "^5.9.0",
    "@shelf/text-normalizer": "^2.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/react-helmet-async": "^1.0.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.6.8",
    "buffer": "^6.0.3",
    "compromise": "^14.14.4",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "pdf2pic": "^3.1.4",
    "pdfjs-dist": "^5.1.91",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.4.1",
    "react-scripts": "^5.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^4.9.5",
    "vercel": "^44.2.8",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "generate-pdf-thumbnails": "node scripts/generate-pdf-thumbnails.js",
    "generate-pdf-publications": "node scripts/generate-pdf-publications.js",
    "process-pdfs": "npm run generate-pdf-thumbnails && npm run generate-pdf-publications",
    "optimize-images": "node scripts/optimize-images.js",
    "add-image": "node scripts/add-image.js",
    "prestart": "node scripts/generate-post-imports.js && npm run process-pdfs && npm run optimize-images",
    "start": "craco start",
    "prebuild": "node scripts/generate-post-imports.js && npm run optimize-images",
    "build": "craco build",
    "build:vercel": "craco build && node scripts/post-build-cleanup.js",
    "test": "craco test",
    "eject": "react-scripts eject",
    "generate-posts": "node scripts/generate-post-imports.js",
    "fetch-gists": "node scripts/fetch-gists.js",
    "generate-audio": "node scripts/generate-audio.js",
    "upload-audio": "node scripts/upload-audio-s3.js",
    "process-audio": "npm run generate-audio && npm run upload-audio",
    "preserve": "node scripts/generate-post-imports.js && npm run process-pdfs && npm run optimize-images",
    "serve": "serve -s build -p 3001"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "glob": "^11.0.1",
    "react-refresh": "^0.17.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.1"
  }
}
