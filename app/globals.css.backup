/* ===============================================
   Global CSS - Consolidated from React App
   =============================================== */

/* ===============================================
   1. CSS Variables & Theming
   =============================================== */
:root {
  /* Layout */
  --content-max-width: 1400px;
  --content-padding: 20px;

  /* Colors - Light Theme */
  --bg-primary: #ffffff;
  --bg-secondary: #f9fafb;
  --bg-tertiary: #f3f4f6;
  --bg-color-rgb: 255, 255, 255;
  --text-primary: #111827;
  --text-secondary: #4b5563;
  --text-tertiary: #6b7280;
  --text-muted: #888888;
  --heading-color: #222222;
  --border-color: #e5e7eb;
  --accent-color: #0066cc;
  --accent-hover: #0052a3;
  --color-primary: #0070f3;
  --color-primary-hover: #0050a3;
  --accent-color-secondary: #0090ff;
  --accent-color-rgb: 0, 112, 243;
  --accent-color-dark: #0050a3;
  --accent-color-light: #e6f0ff;
  
  /* Component Colors */
  --card-bg: #ffffff;
  --card-border: rgba(0, 0, 0, 0.05);
  --tag-bg: #f0f0f0;
  --tag-text: #555555;
  --button-bg: #f4f4f4;
  --button-hover: #e8e8e8;
  --code-bg: #f5f5f5;
  --search-bg: #f5f5f5;
  --hero-bg: linear-gradient(to bottom right, rgba(245, 247, 250, 0.8), rgba(245, 247, 250, 0.4));
  
  /* Typography */
  --font-heading: 'Roboto Mono', 'SF Mono', 'Consolas', monospace;
  --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-size-base: 16px;
  --font-size-small: 14px;
  --font-size-smaller: 13px;
  --font-size-smallest: 12px;
  --line-height-base: 1.6;
  --line-height-content: 1.6;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  --shadow-small: 0 2px 5px rgba(0, 0, 0, 0.1);
  --shadow-medium: 0 3px 12px rgba(0, 0, 0, 0.1);

  /* Radius */
  --radius-small: 3px;
  --radius-medium: 6px;
  --radius-large: 8px;
  --radius-full: 50%;

  /* Spacing */
  --spacing-xs: 5px;
  --spacing-sm: 10px;
  --spacing-md: 15px;
  --spacing-lg: 20px;
  --spacing-xl: 30px;
  --spacing-2xl: 40px;

  /* Transitions */
  --transition-fast: 0.2s ease;
  --transition-medium: 0.3s ease;

  /* iOS 100vh fix */
  --vh: 1vh;
}

/* Dark Theme Variables */
[data-theme="dark"] {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-tertiary: #334155;
  --bg-color-rgb: 18, 18, 18;
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-tertiary: #94a3b8;
  --text-muted: #aaaaaa;
  --heading-color: #e0e0e0;
  --border-color: #334155;
  --accent-color: #60a5fa;
  --accent-hover: #3b82f6;
  --color-primary: #5e9eff;
  --color-primary-hover: #7eaeff;
  --accent-color-secondary: #60a5fa;
  --accent-color-rgb: 94, 158, 255;
  --accent-color-dark: #2a75cc;
  --accent-color-light: rgba(94, 158, 255, 0.15);
  
  /* Component Colors */
  --card-bg: #1e1e1e;
  --card-border: rgba(255, 255, 255, 0.08);
  --tag-bg: #2a2a2a;
  --tag-text: #cccccc;
  --button-bg: #333333;
  --button-hover: #444444;
  --code-bg: #2d2d2d;
  --search-bg: #1e1e1e;
  --hero-bg: linear-gradient(to bottom right, rgba(30, 30, 30, 0.8), rgba(30, 30, 30, 0.4));
  
  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
  --shadow-small: 0 2px 5px rgba(0, 0, 0, 0.3);
  --shadow-medium: 0 3px 12px rgba(0, 0, 0, 0.3);
}

/* ===============================================
   2. Reset & Base Styles
   =============================================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-body);
  line-height: var(--line-height-base);
  color: var(--text-primary);
  background-color: var(--bg-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Links */
a {
  text-decoration: none;
  color: var(--color-primary);
  transition: color var(--transition-fast);
}

a:hover {
  color: var(--color-primary-hover);
}

/* Images */
img {
  max-width: 100%;
  height: auto;
}

/* Code */
code, pre, kbd {
  font-family: var(--font-heading);
}

/* ===============================================
   3. Layout & Structure
   =============================================== */
.main-header {
  background-color: var(--bg-primary);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
}

.main-nav {
  max-width: var(--content-max-width);
  margin: 0 auto;
  padding: 0 1rem;
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 4rem;
  gap: 1rem;
}

.nav-logo {
  font-size: 1.25rem;
  font-weight: bold;
  text-decoration: none;
  color: var(--text-primary);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
  align-items: center;
}

.nav-links a {
  text-decoration: none;
  color: var(--text-secondary);
  font-weight: 500;
  transition: color 0.2s;
}

.nav-links a:hover {
  color: var(--text-primary);
}

.nav-search {
  flex: 1;
  max-width: 400px;
}

/* Main content */
.main-content {
  min-height: calc(100vh - 8rem);
  max-width: var(--content-max-width);
  margin: 0 auto;
  padding: 2rem 1rem;
}

.main-footer {
  background-color: var(--bg-secondary);
  border-top: 1px solid var(--border-color);
  padding: 2rem 0;
}

.footer-container {
  max-width: var(--content-max-width);
  margin: 0 auto;
  padding: 0 1rem;
  text-align: center;
  color: var(--text-secondary);
}

.footer-links {
  margin-top: 1rem;
}

.footer-links a {
  color: var(--text-secondary);
  text-decoration: none;
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--text-primary);
}

.separator {
  margin: 0 0.5rem;
  color: var(--border-color);
}

/* ===============================================
   4. Typography
   =============================================== */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.3;
  color: var(--heading-color);
  margin-bottom: 1rem;
}

h1 {
  font-size: 2.5rem;
}

h2 {
  font-size: 2rem;
}

h3 {
  font-size: 1.5rem;
}

h4 {
  font-size: 1.25rem;
}

h5 {
  font-size: 1.1rem;
}

h6 {
  font-size: 1rem;
}

p {
  margin-bottom: 1.5rem;
}

/* Page Typography */
.page-header {
  margin-bottom: 3rem;
}

.page-title {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.page-subtitle {
  font-size: 1.25rem;
  color: var(--text-secondary);
}

/* ===============================================
   5. Components
   =============================================== */

/* Theme Toggle */
.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--text-secondary);
  transition: color 0.2s;
}

.theme-toggle:hover {
  color: var(--text-primary);
}

/* Mobile Menu */
.mobile-menu-toggle {
  display: none;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.hamburger-box {
  width: 24px;
  height: 24px;
  display: inline-block;
  position: relative;
}

.hamburger-inner {
  display: block;
  top: 50%;
  margin-top: -2px;
  width: 24px;
  height: 2px;
  background-color: var(--text-primary);
  position: absolute;
  transition: transform 0.3s;
}

.hamburger-inner::before,
.hamburger-inner::after {
  width: 24px;
  height: 2px;
  background-color: var(--text-primary);
  position: absolute;
  content: '';
  transition: transform 0.3s;
}

.hamburger-inner::before {
  top: -8px;
}

.hamburger-inner::after {
  bottom: -8px;
}

.hamburger-inner.active {
  transform: rotate(45deg);
}

.hamburger-inner.active::before {
  top: 0;
  transform: rotate(-90deg);
}

.hamburger-inner.active::after {
  bottom: 0;
  opacity: 0;
}

/* Mobile Menu Overlay */
.mobile-menu-overlay {
  position: fixed;
  top: 0;
  left: -100%;
  width: 80%;
  max-width: 300px;
  height: 100vh;
  background-color: var(--bg-primary);
  z-index: 200;
  transition: left 0.3s ease;
  overflow-y: auto;
}

.mobile-menu-overlay.open {
  left: 0;
}

.mobile-menu-nav {
  padding: 2rem;
}

.mobile-menu-header {
  margin-bottom: 2rem;
}

.mobile-menu-logo {
  font-size: 1.5rem;
  font-weight: bold;
  text-decoration: none;
  color: var(--text-primary);
}

.mobile-menu-items {
  list-style: none;
  padding: 0;
}

.mobile-menu-items li {
  margin-bottom: 1rem;
}

.mobile-menu-link {
  display: block;
  padding: 0.75rem 0;
  text-decoration: none;
  color: var(--text-secondary);
  font-size: 1.125rem;
  transition: color 0.2s;
}

.mobile-menu-link:hover,
.mobile-menu-link.active {
  color: var(--text-primary);
}

.mobile-menu-footer {
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-color);
}

.mobile-search-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  color: var(--text-secondary);
  transition: color 0.2s;
}

.mobile-search-link:hover {
  color: var(--text-primary);
}

.mobile-menu-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 199;
}

/* Search Bar */
.search-bar-container {
  position: relative;
  width: 100%;
}

.search-form {
  display: flex;
  align-items: center;
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  transition: border-color 0.2s;
}

.search-form:focus-within {
  border-color: var(--accent-color);
}

.search-input {
  flex: 1;
  padding: 0.5rem 1rem;
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-size: 0.875rem;
  outline: none;
}

.search-button {
  padding: 0.5rem 1rem;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--text-secondary);
}

.search-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 0.5rem;
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: var(--shadow-lg);
  max-height: 400px;
  overflow-y: auto;
  z-index: 50;
}

.search-dropdown-item {
  display: block;
  padding: 0.75rem 1rem;
  text-decoration: none;
  color: var(--text-primary);
  border-bottom: 1px solid var(--border-color);
  transition: background-color 0.2s;
}

.search-dropdown-item:hover {
  background-color: var(--bg-secondary);
}

.search-dropdown-item:last-child {
  border-bottom: none;
}

.search-item-type {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.search-item-title {
  margin: 0.25rem 0;
  font-size: 1rem;
  font-weight: 600;
}

.search-item-description {
  font-size: 0.875rem;
  color: var(--text-secondary);
  margin: 0;
}

.search-view-all {
  display: block;
  padding: 1rem;
  text-align: center;
  text-decoration: none;
  color: var(--accent-color);
  font-weight: 500;
  background-color: var(--bg-secondary);
}

.search-view-all:hover {
  text-decoration: underline;
}

/* Cards */
.blog-card {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.blog-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

/* Tags */
.tag {
  background-color: var(--bg-tertiary);
  color: var(--text-secondary);
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.875rem;
}

/* Audio Player */
.audio-player {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem;
  margin: 1rem 0;
}

.audio-player-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.audio-player-title {
  font-weight: 600;
  color: var(--text-primary);
}

.audio-player-error {
  color: #ef4444;
  font-size: 0.875rem;
}

.audio-player-controls {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.audio-player-play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--accent-color);
  color: white;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s;
}

.audio-player-play-btn:hover:not(:disabled) {
  background-color: var(--accent-hover);
}

.audio-player-play-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.audio-player-time {
  font-size: 0.875rem;
  color: var(--text-secondary);
  white-space: nowrap;
}

.audio-player-progress {
  flex: 1;
  cursor: pointer;
  padding: 0.5rem 0;
}

.audio-player-progress-bar {
  height: 4px;
  background-color: var(--bg-tertiary);
  border-radius: 2px;
  position: relative;
}

.audio-player-progress-fill {
  height: 100%;
  background-color: var(--accent-color);
  border-radius: 2px;
  transition: width 0.1s;
}

.audio-player-speed-btn {
  padding: 0.25rem 0.5rem;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  background-color: transparent;
  color: var(--text-secondary);
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s;
}

.audio-player-speed-btn:hover {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
}

/* Code blocks */
.code-block {
  margin: 1.5rem 0;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  overflow: hidden;
  background-color: var(--bg-secondary);
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  background-color: var(--bg-tertiary);
  border-bottom: 1px solid var(--border-color);
}

.code-filename {
  font-size: 0.875rem;
  color: var(--text-secondary);
  font-family: monospace;
}

.code-action {
  padding: 0.25rem 0.75rem;
  background-color: transparent;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  color: var(--text-secondary);
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.2s;
}

.code-action:hover {
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

.code-container {
  overflow-x: auto;
}

.code-pre {
  margin: 0;
  padding: 1rem 0;
}

.code-table {
  width: 100%;
  border-collapse: collapse;
  font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
  font-size: 0.875rem;
  line-height: 1.5;
}

.line-number {
  width: 1%;
  padding: 0 1rem;
  text-align: right;
  color: var(--text-tertiary);
  user-select: none;
}

.code-line {
  padding: 0 1rem;
  white-space: pre;
  color: var(--text-primary);
}

/* Blog Content */
.blog-content p {
  font-size: var(--font-size-base);
  line-height: var(--line-height-content);
  margin-bottom: 24px;
}

.blog-content h2 {
  font-size: 1.5rem;
  font-weight: 600;
  margin: 2rem 0 1rem;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border-color);
}

.blog-content h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 1.5rem 0 0.75rem;
}

.blog-content a {
  color: var(--color-primary);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color var(--transition-fast);
}

.blog-content a:hover {
  border-color: var(--color-primary);
}

.blog-content code {
  background: var(--code-bg);
  padding: 2px 4px;
  border-radius: var(--radius-small);
  font-size: var(--font-size-small);
  color: #d33682;
}

.blog-content ul,
.blog-content ol {
  margin-bottom: 24px;
  padding-left: 28px;
}

.blog-content li {
  margin-bottom: 10px;
}

.blog-content blockquote {
  margin: var(--spacing-xl) 0;
  padding: 16px 24px;
  border-left: 4px solid var(--border-color);
  background: var(--bg-secondary);
  font-style: italic;
  color: var(--text-primary);
  border-radius: 0 var(--radius-small) var(--radius-small) 0;
}

.blog-content blockquote p:last-child {
  margin-bottom: 0;
}

.blog-content hr {
  height: 1px;
  background: var(--border-color);
  border: none;
  margin: var(--spacing-2xl) 0;
}

.blog-content img {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-medium);
  margin: 30px auto;
  box-shadow: var(--shadow-small);
  display: block;
}

.blog-content figure {
  margin: 30px 0;
  text-align: center;
}

.blog-content figcaption {
  margin-top: 10px;
  font-size: 0.9em;
  color: var(--text-secondary);
  font-style: italic;
}

/* Hero Section */
.hero-section {
  position: relative;
  margin: 0 auto 80px;
  padding: 80px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60vh;
  overflow: visible;
  border-radius: 20px;
  background: var(--hero-bg);
}

.hero-content {
  flex: 1;
  padding: 0 40px;
  z-index: 2;
  max-width: 600px;
}

.hero-title {
  font-size: clamp(2.2rem, 3vw, 3.5rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 20px;
  color: var(--heading-color);
  font-family: var(--font-heading);
}

.hero-subtitle {
  font-size: clamp(0.95rem, 1.5vw, 1.1rem);
  color: var(--text-secondary);
  margin-bottom: 30px;
  line-height: 1.5;
}

/* ===============================================
   6. Responsive Design
   =============================================== */
@media (max-width: 768px) {
  .nav-links,
  .nav-search,
  .theme-toggle {
    display: none;
  }
  
  .mobile-menu-toggle {
    display: block;
  }
  
  .hero-title {
    font-size: 2rem;
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
  }
  
  .posts-grid {
    grid-template-columns: 1fr;
  }
  
  .page-title {
    font-size: 2rem;
  }
  
  .audio-player-controls {
    flex-wrap: wrap;
  }
  
  .audio-player-progress {
    width: 100%;
    order: 3;
  }

  /* Mobile content fixes */
  body, html, #root {
    width: 100vw !important;
    max-width: 100vw !important;
    overflow-x: hidden !important;
  }

  /* Override ALL width styles on mobile */
  * {
    max-width: 100vw !important;
    overflow-wrap: break-word !important;
  }

  /* Fix mobile grids */
  .blog-cards-container {
    grid-template-columns: 1fr !important;
    width: 100% !important;
  }

  /* Blog content mobile adjustments */
  .blog-content {
    font-size: 16px;
    padding: 0 16px;
  }

  .blog-content img {
    margin: 24px -16px;
    width: calc(100% + 32px);
    max-width: calc(100% + 32px);
    border-radius: 0;
  }

  /* Hero section mobile */
  .hero-section {
    flex-direction: column;
    padding: 60px 30px;
    text-align: center;
  }

  .hero-content {
    margin-bottom: 30px;
    max-width: 580px;
    padding: 0;
  }
}

/* Small mobile devices */
@media (max-width: 360px) {
  .blog-title {
    font-size: 18px;
  }

  .blog-content h2 {
    font-size: 16px;
  }

  .blog-content h3 {
    font-size: 15px;
  }
}

/* ===============================================
   7. Animations
   =============================================== */
@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-20px);
  }
  100% {
    transform: translateY(0px);
  }
}

/* ===============================================
   8. Utilities
   =============================================== */
.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(var(--accent-color-rgb), 0.3);
  border-radius: 50%;
  border-top-color: var(--accent-color);
  animation: spin 1s ease-in-out infinite;
}

.no-results {
  text-align: center;
  padding: 3rem 0;
  color: var(--text-secondary);
}

.error-message {
  color: #e74c3c;
  text-align: center;
  padding: 2rem 0;
}

/* Visibility utilities */
.desktop-only {
  display: block;
}

.mobile-only {
  display: none;
}

@media (max-width: 768px) {
  .desktop-only {
    display: none !important;
  }

  .mobile-only {
    display: block !important;
  }
}

/* Prevent horizontal scrolling */
html, body {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

/* Touch-friendly spacing */
@media (max-width: 768px) {
  .touch-target {
    min-height: 44px;
    min-width: 44px;
  }
}

/* Print styles */
@media print {
  .main-header,
  .main-footer,
  .theme-toggle,
  .mobile-menu-toggle,
  .search-bar-container {
    display: none !important;
  }

  .main-content {
    padding: 0;
  }

  .blog-content {
    padding: 0;
  }
}